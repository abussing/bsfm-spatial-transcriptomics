  "code/production/run_k20_cell75_adaptation_chain.sh": {
    "sha256": "edcc2c0729c7c6a7a8f0cf2b31a67e6d13ee59f9792a5000f8dba616be341911",
    "bytes": 2670,
    "text": "#!/usr/bin/env bash\nset -euo pipefail\n\nPROJECT_ROOT=\"${PROJECT_ROOT:-/work/abussing/arka_trying_gpu_again/bsfm_19section_production_20261024}\"\nPYTHON=\"${PYTHON:-/work/abussing/arka_trying_gpu_again/env/bin/python3}\"\nTASK_ID=\"${SLURM_ARRAY_TASK_ID:?Run as a 0-based Slurm array task}\"\nSECTIONS=19\nSECTION_INDEX=\"$((TASK_ID % SECTIONS))\"\nCHAIN_INDEX=\"$((TASK_ID / SECTIONS + 1))\"\n\nmodule load cuda/12.3 gcc/12.2.0\nexport JAX_ENABLE_X64=True\nexport JAX_PLATFORMS=cuda\nexport XLA_FLAGS=\"--xla_gpu_cuda_data_dir=/work/apps/cuda/12.3\"\nexport XLA_PYTHON_CLIENT_PREALLOCATE=false\nTHREADS=\"${SLURM_CPUS_PER_TASK:-4}\"\nexport OPENBLAS_NUM_THREADS=\"$THREADS\"\nexport OMP_NUM_THREADS=\"$THREADS\"\nexport MKL_NUM_THREADS=\"$THREADS\"\n\ncd \"$PROJECT_ROOT\"\nSECTION=\"$($PYTHON -c 'import json,sys; d=json.load(open(\"inputs/INPUT_PREPARATION_CONTRACT.json\")); print(d[\"section_order\"][int(sys.argv[1])])' \"$SECTION_INDEX\")\"\nSOURCE=\"inputs/sections/$SECTION\"\nREDUCED=\"inputs_k20_cell75/sections/$SECTION\"\nOUTPUT=\"adaptation_runs_k20_cell75/$SECTION/chain_$CHAIN_INDEX\"\nSEED=\"$((2026102600 + SECTION_INDEX * 100 + CHAIN_INDEX))\"\n\ntest -s \"$REDUCED/OBSERVATIONS.npz\"\ntest -s \"$REDUCED/gpinit/gpinit.npz\"\ntest -s \"$REDUCED/K20_CELL75_INPUT_CONTRACT.json\"\nif [[ -e \"$OUTPUT/C3FULL_SAMPLER_CERTIFICATE.json\" || -e \"$OUTPUT/LATEST_CHECKPOINT.npz\" ]]; then\n  echo \"REFUSING_NONEMPTY_ADAPTATION output=$OUTPUT\" >&2\n  exit 3\nfi\nmkdir -p \"$OUTPUT\"\ncp code/PRODUCTION_CODE_MANIFEST.json \"$OUTPUT/code_manifest.json\"\ncp code/PRODUCTION_RETENTION_CONTRACT.json \"$OUTPUT/retention_contract.json\"\ncp \"$REDUCED/K20_CELL75_INPUT_CONTRACT.json\" \"$OUTPUT/input_manifest.json\"\n\necho \"K20_CELL75_ADAPTATION_START section=$SECTION chain=$CHAIN_INDEX seed=$SEED host=$(hostname) time=$(date --iso-8601=seconds)\"\n\"$PYTHON\" -u code/sampler/run_c3full_fixed_profile_nuts.py \\\n  --root code --data \"$REDUCED/OBSERVATIONS.npz\" --real-data \\\n  --gpinit \"$REDUCED/gpinit/gpinit.npz\" --mesh \"$SOURCE/mesh\" \\\n  --rule rules/L16_ell14.npz --out \"$OUTPUT\" \\\n  --warmup 100 --sweeps 101 --settling-sweeps 100 --save-every 101 \\\n  --score-n 256 --score-every 25 \\\n  --live-warp-hypers --direct-w --split-E --target-accept 0.9 \\\n  --ell-eta-initial 0.14 --ell-eta-prior-center 0.14 \\\n  --pcg-tolerance 1e-10 --pcg-max-iterations 80 \\\n  --warmup-fidelity-checks 10 --fidelity-every 25 --fidelity-pairs 1024 \\\n  --fidelity-warn-only --max-num-doublings 10 --record-scale-feedback \\\n  --seed \"$SEED\" --ell-u-prior-center 1.0 \\\n  --sigma-u-prior-center 0.31622776601683794 --log-r-prior-sd 0.3\n\ntest -s \"$OUTPUT/LATEST_CHECKPOINT.npz\"\necho \"K20_CELL75_ADAPTATION_END section=$SECTION chain=$CHAIN_INDEX time=$(date --iso-8601=seconds)\"\n"
  },
  "code/production/run_k20_cell75_production_chain.sh": {
    "sha256": "4140124b74f67fb67c1aa050d1ad4e5cec14055aa457a94961eaec7837d60523",
    "bytes": 2892,
    "text": "#!/usr/bin/env bash\nset -euo pipefail\n\nPROJECT_ROOT=\"${PROJECT_ROOT:-/work/abussing/arka_trying_gpu_again/bsfm_19section_production_20261024}\"\nPYTHON=\"${PYTHON:-/work/abussing/arka_trying_gpu_again/env/bin/python3}\"\nTASK_ID=\"${SLURM_ARRAY_TASK_ID:?Run as a 0-based Slurm array task}\"\nSECTIONS=19\nSECTION_INDEX=\"$((TASK_ID % SECTIONS))\"\nCHAIN_INDEX=\"$((TASK_ID / SECTIONS + 1))\"\n\nmodule load cuda/12.3 gcc/12.2.0\nexport JAX_ENABLE_X64=True\nexport JAX_PLATFORMS=cuda\nexport XLA_FLAGS=\"--xla_gpu_cuda_data_dir=/work/apps/cuda/12.3\"\nexport XLA_PYTHON_CLIENT_PREALLOCATE=false\nTHREADS=\"${SLURM_CPUS_PER_TASK:-4}\"\nexport OPENBLAS_NUM_THREADS=\"$THREADS\"\nexport OMP_NUM_THREADS=\"$THREADS\"\nexport MKL_NUM_THREADS=\"$THREADS\"\n\ncd \"$PROJECT_ROOT\"\nSECTION=\"$($PYTHON -c 'import json,sys; d=json.load(open(\"inputs/INPUT_PREPARATION_CONTRACT.json\")); print(d[\"section_order\"][int(sys.argv[1])])' \"$SECTION_INDEX\")\"\nSOURCE=\"inputs/sections/$SECTION\"\nREDUCED=\"inputs_k20_cell75/sections/$SECTION\"\nADAPTATION=\"adaptation_runs_k20_cell75/$SECTION/chain_$CHAIN_INDEX\"\nOUTPUT=\"production_runs_k20_cell75/$SECTION/chain_$CHAIN_INDEX\"\nSEED=\"$((2026102600 + SECTION_INDEX * 100 + CHAIN_INDEX))\"\n\ntest -s \"$ADAPTATION/LATEST_CHECKPOINT.npz\"\nif [[ -e \"$OUTPUT/C3FULL_SAMPLER_CERTIFICATE.json\" || -e \"$OUTPUT/LATEST_CHECKPOINT.npz\" ]]; then\n  echo \"REFUSING_NONEMPTY_PRODUCTION output=$OUTPUT\" >&2\n  exit 3\nfi\nmkdir -p \"$OUTPUT\"\ncp code/PRODUCTION_CODE_MANIFEST.json \"$OUTPUT/code_manifest.json\"\ncp code/PRODUCTION_RETENTION_CONTRACT.json \"$OUTPUT/retention_contract.json\"\ncp \"$REDUCED/K20_CELL75_INPUT_CONTRACT.json\" \"$OUTPUT/input_manifest.json\"\n\necho \"K20_CELL75_PRODUCTION_START section=$SECTION chain=$CHAIN_INDEX seed=$SEED host=$(hostname) time=$(date --iso-8601=seconds)\"\n\"$PYTHON\" -u code/sampler/run_c3full_fixed_profile_nuts.py \\\n  --root code --data \"$REDUCED/OBSERVATIONS.npz\" --real-data \\\n  --gpinit \"$REDUCED/gpinit/gpinit.npz\" --mesh \"$SOURCE/mesh\" \\\n  --rule rules/L16_ell14.npz --out \"$OUTPUT\" \\\n  --resume-checkpoint \"$ADAPTATION/LATEST_CHECKPOINT.npz\" --readapt-on-resume \\\n  --warmup 100 --sweeps 1100 --settling-sweeps 100 --save-every 5 \\\n  --score-n 256 --score-every 5 \\\n  --live-warp-hypers --direct-w --split-E --target-accept 0.95 \\\n  --ell-eta-initial 0.14 --ell-eta-prior-center 0.14 \\\n  --pcg-tolerance 1e-10 --pcg-max-iterations 80 \\\n  --warmup-fidelity-checks 10 --fidelity-every 5 --fidelity-pairs 1024 \\\n  --fidelity-warn-only --max-num-doublings 10 --record-scale-feedback \\\n  --seed \"$SEED\" --ell-u-prior-center 1.0 \\\n  --sigma-u-prior-center 0.31622776601683794 --log-r-prior-sd 0.3\n\n\"$PYTHON\" -c 'import json,sys; d=json.load(open(sys.argv[1])); assert d[\"status\"] in (\"PASS\",\"REVIEW_REQUIRED\"); print(\"CHAIN_CERTIFICATE\",d[\"status\"])' \"$OUTPUT/C3FULL_SAMPLER_CERTIFICATE.json\"\necho \"K20_CELL75_PRODUCTION_END section=$SECTION chain=$CHAIN_INDEX time=$(date --iso-8601=seconds)\"\n"
  },
