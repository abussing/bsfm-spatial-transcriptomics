{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bsfm:retained-archive:v1",
  "title": "Retained inference contract and record v1",
  "oneOf": [
    {
      "$ref": "#/$defs/contract"
    },
    {
      "$ref": "#/$defs/record"
    }
  ],
  "$defs": {
    "contract": {
      "type": "object",
      "required": [
        "schema",
        "chain_id",
        "continuation_contract",
        "continuation_sha256",
        "retention"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "bsfm.retained-archive.v1"
        },
        "chain_id": {
          "type": "string",
          "minLength": 1
        },
        "continuation_contract": {
          "type": "object",
          "required": [
            "schema",
            "target_identity",
            "input_identity",
            "geometry_identity",
            "rule_identity",
            "spectral_identity",
            "factor_ids",
            "b_sigma2_sha256",
            "fixed",
            "software",
            "software_sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "schema": {
              "const": "bsfm.checkpoint-contract.v1"
            },
            "target_identity": {
              "type": "string"
            },
            "input_identity": {
              "type": "string"
            },
            "geometry_identity": {
              "type": "string"
            },
            "rule_identity": {
              "type": "string"
            },
            "spectral_identity": {
              "type": "string"
            },
            "factor_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "b_sigma2_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "fixed": {
              "type": "object",
              "required": [
                "chronology_schema",
                "n_inner",
                "sharing",
                "ell_eta",
                "sigma2_prior_shape",
                "layer6_source_sha256"
              ],
              "additionalProperties": false,
              "properties": {
                "chronology_schema": {
                  "const": "bsfm.layer6-complete-sweep.v1"
                },
                "n_inner": {
                  "const": 3
                },
                "sharing": {
                  "const": 0.2
                },
                "ell_eta": {
                  "const": 0.14
                },
                "sigma2_prior_shape": {
                  "const": 2.0
                },
                "layer6_source_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            },
            "software": {
              "type": "object",
              "required": [
                "git_commit",
                "clean_tree",
                "run_config_sha256",
                "environment_lock_sha256",
                "environment_identity"
              ],
              "additionalProperties": false,
              "properties": {
                "git_commit": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                },
                "clean_tree": {
                  "type": "boolean"
                },
                "run_config_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "environment_lock_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "environment_identity": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "software_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "$comment": "Verbatim structure from checkpoint-v1.schema.json properties.contract; verified in review checks. Numerical implementation reuses the accepted Layer-7 contract."
        },
        "continuation_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "retention": {
          "type": "object",
          "required": [
            "save_every",
            "settling_sweeps",
            "final_sweep",
            "rule"
          ],
          "additionalProperties": false,
          "properties": {
            "save_every": {
              "type": "integer",
              "minimum": 1
            },
            "settling_sweeps": {
              "type": "integer",
              "minimum": 0
            },
            "final_sweep": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "rule": {
              "const": "post_settling_and_first_or_modulo_or_final"
            }
          }
        }
      }
    },
    "record": {
      "type": "object",
      "required": [
        "schema",
        "contract_sha256",
        "status",
        "sweep",
        "production_sweep",
        "retained_index",
        "previous_sha256",
        "diagnostics",
        "arrays",
        "logical_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "bsfm.retained-record.v1"
        },
        "contract_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "enum": [
            "completed",
            "failed"
          ]
        },
        "sweep": {
          "type": "integer",
          "minimum": 1
        },
        "production_sweep": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "retained_index": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "previous_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "diagnostics": {
          "type": "object",
          "description": "Exact status-specific typed diagnostics, closed keys/domain rules in retained_diagnostics.validate_diagnostics."
        },
        "arrays": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "dtype",
              "shape",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "dtype": {
                "type": "string"
              },
              "shape": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "logical_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  "description": "Runtime additionally enforces target-dependent shapes, byte/logical hashes, record continuity, retention predicate, exact reconstruction, diagnostic schemas and no failure-as-success. No checkpoint mutation."
}
