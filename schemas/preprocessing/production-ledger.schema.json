{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "const": "bsfm.production-run-ledger.v1"
    },
    "run_spec_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "running",
        "failed",
        "closing",
        "complete"
      ]
    },
    "section_order": {
      "type": "array",
      "minItems": 19,
      "maxItems": 19,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string"
          },
          "source_start": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "initial_stat": {
                "type": "object",
                "properties": {
                  "st_size": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "st_mtime_ns": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "st_ctime_ns": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "st_dev": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "st_ino": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "st_size",
                  "st_mtime_ns",
                  "st_ctime_ns",
                  "st_dev",
                  "st_ino"
                ],
                "additionalProperties": false
              },
              "authenticated_at": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "bytes",
              "sha256",
              "initial_stat",
              "authenticated_at"
            ],
            "additionalProperties": false
          },
          "end": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_final": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "initial_stat": {
                    "type": "object",
                    "properties": {
                      "st_size": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "st_mtime_ns": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "st_ctime_ns": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "st_dev": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "st_ino": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "st_size",
                      "st_mtime_ns",
                      "st_ctime_ns",
                      "st_dev",
                      "st_ino"
                    ],
                    "additionalProperties": false
                  },
                  "authenticated_at": {
                    "type": "string"
                  }
                },
                "required": [
                  "path",
                  "bytes",
                  "sha256",
                  "initial_stat",
                  "authenticated_at"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "start",
          "source_start",
          "end",
          "source_final"
        ],
        "additionalProperties": false
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "time": {
            "type": "string"
          },
          "event": {
            "type": "string"
          },
          "section": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "time",
          "event",
          "section"
        ],
        "additionalProperties": false
      }
    },
    "sections": {
      "type": "object",
      "minProperties": 19,
      "maxProperties": 19,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "state": {
            "enum": [
              "pending",
              "running",
              "failed",
              "promoted"
            ]
          },
          "attempts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^\\.attempt-[A-Za-z0-9_-]+$"
                },
                "state": {
                  "enum": [
                    "started",
                    "interrupted",
                    "failed",
                    "promoted"
                  ]
                },
                "cleanup": {
                  "enum": [
                    "retained",
                    "pending",
                    "removed",
                    "already_absent",
                    "retained_failed"
                  ]
                },
                "started": {
                  "type": "string"
                },
                "ended": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "id",
                "state",
                "cleanup",
                "started",
                "ended"
              ],
              "additionalProperties": false
            }
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "observed_at": {
                  "type": "string"
                },
                "available_ram_bytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "free_disk_bytes": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "observed_at",
                "available_ram_bytes",
                "free_disk_bytes"
              ],
              "additionalProperties": false
            }
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "time": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "fast_closed_file_schema_hash_provenance",
                    "deep_before_promotion_plus_fast_after"
                  ]
                },
                "elapsed_seconds": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "time",
                "kind"
              ],
              "additionalProperties": false
            }
          },
          "manifest": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "path",
                  "bytes",
                  "sha256"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "receipt": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "state",
          "attempts",
          "resources",
          "checks",
          "manifest",
          "receipt"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "run_spec_sha256",
    "status",
    "section_order",
    "sessions",
    "events",
    "sections"
  ],
  "additionalProperties": false
}
