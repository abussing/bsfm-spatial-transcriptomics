{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experimental Phase-0 candidate specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "experimental", "synthetic", "candidate", "provenance", "environment_root", "config", "input_transport", "transform", "collar", "edge_cap", "ranges", "probe_identities_sha256"],
  "properties": {
    "schema": {"const": "bsfm.mesh.phase0.spec.v1"},
    "experimental": {"const": true},
    "synthetic": {"type": "boolean"},
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "h", "buffer"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]+$"},
        "h": {"type": "number", "exclusiveMinimum": 0},
        "buffer": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "provenance": {"type": "object", "required": ["code", "environment"]},
    "environment_root": {"type": "string", "minLength": 1},
    "config": {"type": "object", "required": ["geometry", "numerics", "resources", "probes"]},
    "input_transport": {"$ref": "#/$defs/file"},
    "transform": {"type": "object", "required": ["origin", "scale", "raw_hash", "numerical_hash", "axis_order"]},
    "collar": {"type": "number", "exclusiveMinimum": 0},
    "edge_cap": {"type": "number", "exclusiveMinimum": 0},
    "ranges": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["range_id", "ell", "role"],
        "properties": {
          "range_id": {"type": "string"},
          "ell": {"type": "number", "exclusiveMinimum": 0},
          "role": {"type": "string"}
        }, "additionalProperties": false
      }
    },
    "probe_identities_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "file": {
      "type": "object", "required": ["bytes", "sha256"], "additionalProperties": false,
      "properties": {
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
